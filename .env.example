# Preferred: OpenRouter hosts the Jev Decisions API. This one key can also be used for TEXT_MODEL_API_KEY.
OPENROUTER_API_KEY=
JEV_DECISIONS_BASE_URL=https://openrouter.ai/api/alpha/decisions
JEV_DECISIONS_MODEL=~typesafe/jev-latest

# Alternative direct TypeSafe configuration, used only when OPENROUTER_API_KEY is absent.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Required whenever Jev has to enter text into a search or filter field.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
